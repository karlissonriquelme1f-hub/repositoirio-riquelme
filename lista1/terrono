using System;

class Program
{
    static void Main()
    {
        Console.WriteLine("=== Problema: Terreno ===");

        Console.Write("Digite a largura do terreno (m): ");
        double largura = double.Parse(Console.ReadLine());

        Console.Write("Digite o comprimento do terreno (m): ");
        double comprimento = double.Parse(Console.ReadLine());

        Console.Write("Digite o preço do metro quadrado (R$): ");
        double precoMetro = double.Parse(Console.ReadLine());

        double area = largura * comprimento;
        double precoTotal = area * precoMetro;

        Console.WriteLine($"\nÁrea do terreno: {area:F2} m²");
        Console.WriteLine($"Preço total do terreno: R$ {precoTotal:F2}");
    }
}
