using System;

class Program
{
    static void Main()
    {
        Console.WriteLine("=== Problema: Idades ===");

        Console.Write("Digite o nome da primeira pessoa: ");
        string nome1 = Console.ReadLine();
        Console.Write("Digite a idade de " + nome1 + ": ");
        double idade1 = double.Parse(Console.ReadLine());

        Console.Write("Digite o nome da segunda pessoa: ");
        string nome2 = Console.ReadLine();
        Console.Write("Digite a idade de " + nome2 + ": ");
        double idade2 = double.Parse(Console.ReadLine());

        double media = (idade1 + idade2) / 2;

        Console.WriteLine($"\nA idade média de {nome1} e {nome2} é {media:F1} anos.");
    }
}
