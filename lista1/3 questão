using System;

class Program
{
    static void Main()
    {
        Console.WriteLine("=== Problema: Troco ===");

        Console.Write("Preço unitário do produto: R$ ");
        double preco = double.Parse(Console.ReadLine());

        Console.Write("Quantidade comprada: ");
        int quantidade = int.Parse(Console.ReadLine());

        Console.Write("Dinheiro recebido: R$ ");
        double dinheiro = double.Parse(Console.ReadLine());

        double total = preco * quantidade;
        double troco = dinheiro - total;

        Console.WriteLine($"\nTotal da compra: R$ {total:F2}");
        Console.WriteLine($"Troco a ser devolvido: R$ {troco:F2}");
    }
}
