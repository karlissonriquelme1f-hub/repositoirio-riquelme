using System;

class Program
{
    static void Main()
    {
        Console.WriteLine("=== Problema: Operadora ===");

        double valorBasico = 50.00;
        int franquia = 100;
        double valorExcedente = 2.00;

        Console.Write("Digite a quantidade de minutos usados: ");
        int minutos = int.Parse(Console.ReadLine());

        double valorTotal = valorBasico;
        if (minutos > franquia)
        {
            valorTotal += (minutos - franquia) * valorExcedente;
        }

        Console.WriteLine($"\nValor a pagar: R$ {valorTotal:F2}");
    }
}
